# Copy to .env and fill in real values. All keys are required (see app/core/config.py).

APP_NAME=Arth
APP_VERSION=0.2.0
ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/arth

# Auth — generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
